generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Institution {
  id          String   @id @default(cuid())
  name        String   @unique
  active      Boolean @default(true)
  template    String
  hasCover    Boolean @default(false)
  dniRequired Boolean @default(false)
  showDni     Boolean @default(false)
  dniMode     String   @default("OPTIONAL")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
