{
  "name": "back",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/institutions.integration.test.js tests/google-auth.test.js",
    "dev": "nodemon index.js",
    "start": "node index.js",
    "db:up": "docker compose -f ../docker-compose.yml up -d --wait postgres",
    "db:down": "docker compose -f ../docker-compose.yml down",
    "db:logs": "docker compose -f ../docker-compose.yml logs -f postgres",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:generate": "prisma generate",
    "db:setup": "npm run db:generate && npm run db:migrate && npm run db:seed"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "6.19.3",
    "cors": "^2.8.5",
    "docxtemplater": "^3.67.5",
    "expres": "^0.0.5",
    "express": "^5.1.0",
    "googleapis": "^182.0.0",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "nodemon": "^3.1.11",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pizzip": "^3.2.0"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  }
}
